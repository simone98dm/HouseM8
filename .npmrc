# @simone98dm/* is published to GitHub Packages, not the public registry.
# The auth token is read from the GITHUB_TOKEN env variable. It must be set:
# yarn 1 aborts every command (even `yarn run`) when an ${ENV} placeholder
# in .npmrc is unset. Locally: export GITHUB_TOKEN=$(gh auth token)
@simone98dm:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
